{
    "name": "readytogift",
    "compatibility_date": "2026-04-21",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true
        }
    },
    "kv_namespaces": [
        {
            "binding": "CACHE",
            "id": "88be1f5c132e46c794698d494fa01947"
        },
        {
            "binding": "SESSION",
            "id": "6b93206edd314faf8704adedadcce336"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "readytogift-prod",
            "database_id": "c5a00055-e5d6-4e47-8f46-212f9c9e9e81",
            "remote": true
        }
    ]
}
