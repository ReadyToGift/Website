{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "timezone": "Europe/London",
    "separateMajorMinor": false,
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "automergeType": "branch",
        "schedule": ["every 2 weeks before 9am on friday"]
    },
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchManagers": ["npm"],
            "minimumReleaseAge": "7 days"
        },
        {
            "matchPackageNames": ["node-appwrite"],
            "groupName": "Migration tooling"
        },
        {
            "matchPackageNames": ["astro", "@astrojs/*"],
            "groupName": "astro"
        },
        {
            "matchPackageNames": ["better-auth", "@better-auth/*"],
            "groupName": "better-auth"
        },
        {
            "matchPackageNames": ["@dicebear/*"],
            "groupName": "dicebear"
        },
        {
            "matchPackageNames": ["nanostores", "@nanostores/*"],
            "groupName": "nanostores"
        },
        {
            "matchPackageNames": ["@polar-sh/*"],
            "groupName": "polar"
        },
        {
            "matchPackageNames": ["@sentry/*"],
            "groupName": "sentry"
        },
        {
            "matchUpdateTypes": ["pin", "pinDigest"],
            "groupName": "Pin dependencies",
            "groupSlug": "pin-dependencies"
        }
    ],
    "baseBranchPatterns": ["master"]
}
