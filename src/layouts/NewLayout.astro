---
// import "@/styles/global.css";
import "@/styles/starwind.css";
import { SidebarContent, SidebarProvider, SidebarTrigger } from "@/components/starwind/sidebar";
import Sidebar from "@/components/Sidebar.astro";

const { title, user } = Astro.props;
---

<!doctype html>
<html lang="en" class={user?.prefs?.darkMode ? "dark" : ""}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} - Readyto.gift</title>
    </head>
    <body>
        <SidebarProvider>
            <Sidebar user={user} />
            <main class="bg-background flex flex-1 flex-col">
                <header class="flex h-12 shrink-0 items-center gap-2 border-b px-4">
                    <SidebarTrigger />
                    <span class="text-muted-foreground text-sm">{title}</span>
                </header>
                <div class="flex-1 p-6 content">
                    <slot />
                </div>
            </main>
        </SidebarProvider>
    </body>
</html>

<style lang="scss" scoped>
    .content {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }
</style>
