---
import {
    APPWRITE_DB,
    APPWRITE_LIST_COLLECTION,
    APPWRITE_PROJECT,
    APPWRITE_ENDPOINT,
    APPWRITE_IMAGE_BUCKET
} from "astro:env/client";

import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { ButtonGroup, ButtonGroupSeparator, ButtonGroupText } from "@/components/ui/button-group";
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle
} from "@/components/ui/card";

import { Icon } from "astro-icon/components";

import { formatter as currencyFormatter } from "@/stores/currency";
import { convertPriority } from "@/utils";

const { item, list } = Astro.props;

const imageURL = (item) => {
    if (item.image) {
        return item.image;
    }
    if (item.imageID) {
        const params = new URLSearchParams({
            project: APPWRITE_PROJECT,
            output: "png",
            height: "400"
        });

        return `${APPWRITE_ENDPOINT}/storage/buckets/${APPWRITE_IMAGE_BUCKET}/files/${item.imageID}/preview?${params.toString()}`;
    }
    return null;
};

const previewImageUrl = imageURL(item);
---

<Card key={item.$id}>
    <CardHeader>
        <CardTitle>{item.title || "Untitled Item"}</CardTitle>
        <CardAction>
            <ButtonGroup>
                <ButtonGroup>
                    <Button size="lg">
                        Fullfill
                        <Icon data-icon="inline-end" name="mdi:gift" />
                    </Button>
                </ButtonGroup>
                <ButtonGroup>
                    {
                        item.url && (
                            <Button asChild>
                                <a
                                    href={item.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={buttonVariants()}
                                >
                                    View
                                    <Icon data-icon="inline-end" name="mdi:open-in-new" />
                                </a>
                            </Button>
                        )
                    }
                </ButtonGroup>
            </ButtonGroup>
        </CardAction>
    </CardHeader>
    <div
        class:list={[
            "px-4 pb-1",
            previewImageUrl && "grid gap-4 sm:grid-cols-[1fr_220px] sm:items-start"
        ]}
    >
        <CardContent className="px-0">
            <p class="text-sm leading-relaxed text-muted-foreground">
                {item.description || "No description yet."}
            </p>
        </CardContent>
        {
            previewImageUrl && (
                <div class="overflow-hidden rounded-lg bg-muted/30 p-2 shadow-sm sm:justify-self-end sm:w-full sm:max-w-[220px]">
                    <img
                        src={previewImageUrl}
                        alt={item.title}
                        loading="lazy"
                        class="h-auto max-h-[220px] w-full object-contain"
                    />
                </div>
            )
        }
    </div>
    {
        (item.price && item.displayPrice) ||
        item.fulfilledBy ||
        (item.priority && item.priority !== "none") ? (
            <CardFooter>
                <div class="chips">
                    {item.price && item.displayPrice && (
                        <Badge variant="outline">
                            {currencyFormatter(list.currency).format(item.price)}
                        </Badge>
                    )}
                    {item.fulfilledBy && (
                        <Badge className="bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                            Fulfilled by {item.fulfilledBy}
                        </Badge>
                    )}
                    {item.priority && item.priority !== "none" && (
                        <Badge
                            variant="outline"
                            className={convertPriority(item.priority).badgeClassName}
                        >
                            <Icon
                                data-icon="inline-start"
                                name={convertPriority(item.priority).iconId}
                            />
                            {convertPriority(item.priority).text}
                        </Badge>
                    )}
                </div>
            </CardFooter>
        ) : null
    }
</Card>
