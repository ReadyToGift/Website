---
import {
    APPWRITE_DB,
    APPWRITE_LIST_COLLECTION,
    APPWRITE_PROJECT,
    APPWRITE_ENDPOINT,
    APPWRITE_IMAGE_BUCKET
} from "astro:env/client";

import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { ButtonGroup, ButtonGroupSeparator, ButtonGroupText } from "@/components/ui/button-group";
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle
} from "@/components/ui/card";

import { Icon } from "astro-icon/components";

import { formatter as currencyFormatter } from "@/stores/currency";
import { convertPriority } from "@/utils";

const { item, list } = Astro.props;

const imageURL = (item) => {
    if (item.imageID) {
        const params = new URLSearchParams({
            project: APPWRITE_PROJECT,
            output: "png",
            height: "400"
        });

        return `${APPWRITE_ENDPOINT}/storage/buckets/${APPWRITE_IMAGE_BUCKET}/files/${item.imageID}/preview?${params.toString()}`;
    }
    return null;
};
---

<Card key={item.$id} className="w-full">
    {
        imageURL(item) && (
            <img
                src={imageURL(item)}
                alt={item.title}
                className="relative z-20 aspect-video w-full object-cover brightness-60 grayscale dark:brightness-40"
            />
        )
    }
    <CardHeader>
        <CardTitle>{item.title || "Untitled Item"}</CardTitle>
        <CardAction>
            <ButtonGroup>
                <ButtonGroup>
                    <Button size="lg">
                        Fullfill
                        <Icon data-icon="inline-end" name="mdi:gift" />
                    </Button>
                </ButtonGroup>
                <ButtonGroup>
                    {
                        item.url && (
                            <Button asChild>
                                <a
                                    href={item.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={buttonVariants()}
                                >
                                    View
                                    <Icon data-icon="inline-end" name="mdi:open-in-new" />
                                </a>
                            </Button>
                        )
                    }
                </ButtonGroup>
            </ButtonGroup>
        </CardAction>
    </CardHeader>
    <CardContent>{item.description}</CardContent>
    {
        (item.price && item.displayPrice) ||
        item.fulfilledBy ||
        (item.priority && item.priority !== "none") ? (
            <CardFooter>
                <div class="chips">
                    {item.price && item.displayPrice && (
                        <Badge variant="outline">
                            {currencyFormatter(list.currency).format(item.price)}
                        </Badge>
                    )}
                    {item.fulfilledBy && (
                        <Badge className="bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                            Fulfilled by {item.fulfilledBy}
                        </Badge>
                    )}
                    {item.priority && item.priority !== "none" && (
                        <Badge
                            variant="outline"
                            className={convertPriority(item.priority).badgeClassName}
                        >
                            <Icon
                                data-icon="inline-start"
                                name={convertPriority(item.priority).iconId}
                            />
                            {convertPriority(item.priority).text}
                        </Badge>
                    )}
                </div>
            </CardFooter>
        ) : null
    }
</Card>
