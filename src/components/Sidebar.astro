---
import {
    Sidebar,
    SidebarContent,
    SidebarGroup,
    SidebarGroupContent,
    SidebarGroupLabel,
    SidebarHeader,
    SidebarMenu,
    SidebarMenuButton,
    SidebarMenuItem,
    SidebarProvider,
    SidebarTrigger,
    SidebarFooter
} from "@/components/starwind/sidebar";

import {
    Dropdown,
    DropdownContent,
    DropdownItem,
    DropdownLabel,
    DropdownSeparator,
    DropdownTrigger
} from "@/components/starwind/dropdown";

import { Button } from "@/components/starwind/button";

import { Switch } from "@/components/starwind/switch";

import { Avatar, AvatarFallback, AvatarImage } from "@/components/starwind/avatar";

import { Icon } from "astro-icon/components";

import { createAdminClient } from "@/server/appwrite";

const adminClient = createAdminClient();

const { user } = Astro.props;

let avatarUrl = "";
let historyItems = [];
if (user) {
    const avatarBuffer = await adminClient.avatars.getInitials({
        name: user.name,
        size: 128
    });

    avatarUrl = `data:image/png;base64,${Buffer.from(avatarBuffer).toString("base64")}`;

    historyItems = user.prefs?.history || [];
}
---

<Sidebar collapsible="icon">
    <SidebarHeader>
        <SidebarMenu>
            <SidebarMenuItem>
                <SidebarMenuButton size="lg">
                    <div
                        class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-10 items-center justify-center rounded-lg"
                    >
                        <Icon name="mdi:gift" />
                    </div>
                    <div class="grid flex-1 text-left text-sm leading-tight">
                        <span class="truncate font-semibold">Readyto.gift</span>
                        <!-- 
                            TODO: Add plan level
                        <span class="text-sidebar-foreground/70 truncate text-xs">
                        </span>
                        -->
                    </div>
                </SidebarMenuButton>
            </SidebarMenuItem>
        </SidebarMenu>
    </SidebarHeader>
    <SidebarContent>
        <SidebarGroup>
            <SidebarGroupLabel>Application</SidebarGroupLabel>
            <SidebarGroupContent>
                <SidebarMenu>
                    <SidebarMenuItem>
                        <SidebarMenuButton href="/dash/lists">
                            <Icon name="mdi:format-list-bulleted" />
                            <span>Lists</span>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarGroupContent>
        </SidebarGroup>

        {
            historyItems && historyItems.length > 0 && (
                <SidebarGroup>
                    <SidebarGroupLabel>Recently Viewed</SidebarGroupLabel>
                    <SidebarGroupContent>
                        <SidebarMenu>
                            {historyItems.map((item) => (
                                <SidebarMenuItem key={item.id}>
                                    <SidebarMenuButton href={`/list/${item.id}`}>
                                        <Avatar class="size-6 shrink-0 rounded-sm">
                                            <AvatarImage src={item.avatar} alt={item.title} />
                                        </Avatar>
                                        <div class="grid flex-1 text-left text-sm leading-tight">
                                            <span class="truncate font-semibold">{item.title}</span>
                                            <span class="text-sidebar-foreground/70 truncate text-xs">
                                                {item.subtitle}
                                            </span>
                                        </div>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            ))}
                        </SidebarMenu>
                    </SidebarGroupContent>
                </SidebarGroup>
            )
        }
    </SidebarContent>
    <SidebarFooter>
        <SidebarMenu>
            {
                user && (
                    <SidebarMenuItem>
                        <Dropdown>
                            <DropdownTrigger asChild>
                                <SidebarMenuButton size="lg">
                                    <Avatar class="size-10 shrink-0 rounded-lg">
                                        <AvatarImage src={avatarUrl} alt={user.name} />
                                    </Avatar>
                                    <div class="grid flex-1 text-left text-sm leading-tight">
                                        <span class="truncate font-semibold">{user.name}</span>
                                        <span class="text-sidebar-foreground/70 truncate text-xs">
                                            {user.email}
                                        </span>
                                    </div>
                                    <Icon name="mdi:chevron-up" class="ml-auto size-4" />
                                </SidebarMenuButton>
                            </DropdownTrigger>
                            <DropdownContent class="w-full min-w-48 rounded-lg" side="top">
                                <DropdownLabel class="p-0 font-normal">
                                    <div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
                                        <Avatar class="size-8 rounded-lg">
                                            <AvatarImage src={avatarUrl} alt={user.name} />
                                        </Avatar>
                                        <div class="grid flex-1 text-left text-sm leading-tight">
                                            <span class="truncate font-semibold">{user.name}</span>
                                            <span class="text-muted-foreground truncate text-xs">
                                                {user.email}
                                            </span>
                                        </div>
                                    </div>
                                </DropdownLabel>
                                <DropdownSeparator />

                                <div class="px-3 py-2">
                                    <div class="py-2">
                                        <Switch
                                            id="quick-dark-mode"
                                            label="Dark Mode"
                                            variant="primary"
                                            checked={user?.prefs?.darkMode}
                                        />
                                    </div>
                                    <div class="py-2">
                                        <Switch
                                            id="quick-show-total"
                                            label="Show Total Price"
                                            variant="primary"
                                            checked={user?.prefs?.showTotalPrice}
                                        />
                                    </div>
                                    <div class="py-2">
                                        <Switch
                                            id="quick-spoil-surprises"
                                            label="Spoil Surprises"
                                            variant="primary"
                                            checked={user?.prefs?.spoilSurprises}
                                        />
                                    </div>
                                    <div class="flex justify-end pt-2">
                                        <Button id="quick-save-prefs" size="sm">
                                            Save
                                        </Button>
                                    </div>
                                </div>

                                <DropdownItem as="a" href="#">
                                    <Icon name="mdi:sparkles" class="mr-2 size-4" />
                                    Upgrade to Pro
                                </DropdownItem>
                                <DropdownSeparator />
                                <DropdownItem as="a" href="#">
                                    <Icon name="mdi:badge" class="mr-2 size-4" />
                                    Account
                                </DropdownItem>
                                <DropdownItem as="a" href="#">
                                    <Icon name="mdi:credit-card" class="mr-2 size-4" />
                                    Billing
                                </DropdownItem>
                                <DropdownItem as="a" href="#">
                                    <Icon name="mdi:bell" class="mr-2 size-4" />
                                    Notifications
                                </DropdownItem>
                                <DropdownSeparator />
                                <DropdownItem as="a" href="#">
                                    <Icon name="mdi:logout" class="mr-2 size-4" />
                                    Log out
                                </DropdownItem>
                            </DropdownContent>
                        </Dropdown>
                    </SidebarMenuItem>
                )
            }
        </SidebarMenu>
    </SidebarFooter>
</Sidebar>

<script>
    import { account } from "@/appwrite";

    const darkEl = document.getElementById("quick-dark-mode");
    const totalEl = document.getElementById("quick-show-total");
    const spoilEl = document.getElementById("quick-spoil-surprises");
    const saveBtn = document.getElementById("quick-save-prefs");

    const readAndSave = async () => {
        const updated = {
            darkMode: darkEl.getAttribute("aria-checked") === "true",
            showTotalPrice: totalEl ? totalEl.getAttribute("aria-checked") === "true" : false,
            spoilSurprises: spoilEl ? spoilEl.getAttribute("aria-checked") === "true" : false
        };

        const user = await account.get();

        const newPrefs = Object.assign({}, user.prefs, updated);
        if (user) {
            await account.updatePrefs(newPrefs);
        }
        window.location.reload();
    };

    if (saveBtn)
        saveBtn.addEventListener("click", (e) => {
            e.preventDefault();
            readAndSave();
        });
</script>
