---
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle
} from "@/components/starwind/card";
import { Button } from "@/components/starwind/button";
import { Badge } from "@/components/starwind/badge";

import { Icon } from "astro-icon/components";

import { formatter as currencyFormatter } from "@/stores/currency";

import ListManagementButtons from "@/components/new/dialogs/ListManagementButtons.vue";

const { list, user } = Astro.props;

// TODO: Implement these
const ownList = false;
const communityItems = [];
const spoilSurprises = false;
let showTotalPrice = true;

if (user && user.prefs) {
    showTotalPrice = user.prefs.showTotalPrice || false;
}

const totalPrice = currencyFormatter(list.currency).format(
    list.items.reduce((sum, item) => sum + (item.price || 0), 0) +
        (!ownList || (ownList && spoilSurprises)
            ? communityItems.reduce((sum, item) => sum + (item.price || 0), 0)
            : 0)
);
---

<Card className="w-full my-4">
    <CardHeader>
        <CardTitle>{list.title || "Untitled List"}</CardTitle>
        {list.description && <CardDescription>{list.description}</CardDescription>}
    </CardHeader>

    <CardContent class="pt-2">
        <CardAction>
            <!-- <Button>Share <Icon name="mdi:share" /></Button> -->
            {
                (
                    // ownList && (
                    //     )
                    <ListManagementButtons list={list} wishlistOwner="true" client:only="vue" />
                )
            }
        </CardAction>
    </CardContent>

    <CardFooter>
        <div class="flex flex-wrap gap-2">
            <Badge variant="outline">
                <Icon name="mdi:format-list-bulleted" data-icon="inline-start" />
                {list.items ? list.items.length : 0}
                {list.items && list.items.length === 1 ? " item" : " items"}
            </Badge>
            <Badge variant="outline">
                {
                    list.$updatedAt && (
                        <>
                            <Icon name="mdi:update" data-icon="inline-start" />
                            Updated{" "}
                            {new Date(list.$updatedAt).toLocaleDateString(undefined, {
                                year: "numeric",
                                month: "short",
                                day: "numeric"
                            })}
                        </>
                    )
                }
            </Badge>
            {
                showTotalPrice && (
                    <Badge variant="outline">
                        <Icon name="mdi:invoice-list" data-icon="inline-start" />
                        {totalPrice}
                    </Badge>
                )
            }
        </div>
    </CardFooter>
</Card>
