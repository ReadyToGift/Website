---
const { section } = Astro.props;
const image = section?.imageUrl || section?.imageData || section?.image || null;
const text = section?.text || "";
const title = section?.title || "";
---

<section
    class:list-section-image-text={section.type === "image-text"}
    class:list-section-text-image={section.type === "text-image"}
    class="wedding-section"
>
    {section.type === "text" && title && <h2>{title}</h2>}
    {section.type === "image" && image && (
        <img
            class="section-image"
            src={image}
            alt={title}
            loading="lazy"
            width="1600"
            height="533"
        />
    )}
    {section.type === "text" && text && <p>{text}</p>}
    {(section.type === "image-text" || section.type === "text-image") && (
        <div class="section-content">
            {image && (
                <img
                    class="section-image"
                    src={image}
                    alt={title}
                    loading="lazy"
                    width="800"
                    height="600"
                />
            )}
            <div class="section-copy">
                {title && <h2>{title}</h2>}
                {text && <p>{text}</p>}
            </div>
        </div>
    )}
</section>

<style>
.wedding-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 5rem 0;
}

.wedding-section h2,
.wedding-section p {
    margin: 0;
    white-space: pre-wrap;
}

.wedding-section h2 {
    text-decoration: underline;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 1rem;
    color: #191c20;
    text-decoration-color: var(--wedding-accent-light, #6e94b0);
    margin-bottom: 2rem;

    font-size: 2rem;
}

.wedding-section p {
    font-size: 1.25rem;
}

.wedding-section img {
    display: block;
    border-radius: 1rem;
    max-height: 32rem;
    max-width: 100%;
    object-fit: cover;
}

.wedding-section > .section-image {
    aspect-ratio: 3 / 1;
    height: auto;
    width: 100%;
}

.section-content {
    display: grid;
    align-items: center;
    gap: 5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.section-content > .section-image {
    aspect-ratio: 4 / 3;
    height: auto;
    width: 100%;
}

.list-section-image-text .section-image {
    grid-column: 1;
}

.list-section-image-text .section-copy {
    grid-column: 2;
}

.list-section-text-image .section-image {
    grid-column: 2;
    grid-row: 1;
}

.list-section-text-image .section-copy {
    grid-column: 1;
    grid-row: 1;
}

@media (max-width: 768px) {
    .section-content {
        grid-template-columns: 1fr;
    }

    .section-content > .section-image {
        grid-column: auto;
        grid-row: auto;
        width: 100%;
    }

    .list-section-text-image .section-content .section-copy {
        grid-column: auto;
        grid-row: auto;
        order: -1;
    }
}
</style>
