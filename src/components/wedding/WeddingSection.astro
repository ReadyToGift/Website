---
const { section } = Astro.props;
const image = section?.imageUrl || section?.imageData || section?.image || null;
const text = section?.text || "";
const title = section?.title || "";
---

<section
    class:list={[
        "wedding-section",
        {
            "list-section-image": section.type === "image",
            "list-section-image-text": section.type === "image-text",
            "list-section-text-image": section.type === "text-image",
        },
    ]}
    data-wedding-section
>
    {section.type === "text" && title && <h2>{title}</h2>}
    {section.type === "image" && image && (
        <img
            class="section-image"
            src={image}
            alt={title}
            loading="lazy"
            width="1600"
            height="900"
        />
    )}
    {section.type === "text" && text && <p>{text}</p>}
    {(section.type === "image-text" || section.type === "text-image") && (
        <div class="section-content">
            {image && (
                <img
                    class="section-image"
                    src={image}
                    alt={title}
                    loading="lazy"
                    width="800"
                    height="600"
                />
            )}
            <div class="section-copy">
                {title && <h2>{title}</h2>}
                {text && <p>{text}</p>}
            </div>
        </div>
    )}
</section>

<style>
.wedding-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
}

.wedding-section h2,
.wedding-section p {
    margin: 0;
    white-space: pre-wrap;
}

.wedding-section h2 {
    color: #151515;
    font-size: clamp(2.4rem, 3.7vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    position: relative;
}

.wedding-section h2::after {
    background: var(--wedding-accent-light, #a9c9dc);
    bottom: -0.9rem;
    content: "";
    height: 1px;
    left: 0;
    position: absolute;
    width: 3.4rem;
}

.wedding-section p {
    font-size: clamp(1.25rem, 2.1vw, 1.85rem);
    line-height: 1.15;
    max-width: 73rem;
}

.wedding-section img {
    display: block;
    max-width: 100%;
    object-fit: cover;
}

.wedding-section > .section-image {
    aspect-ratio: 16 / 9;
    height: auto;
    width: 100%;
}

.section-content {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.section-content > .section-image {
    aspect-ratio: 3 / 2;
    height: auto;
    width: 100%;
}

.list-section-image-text .section-image {
    grid-column: 1;
}

.list-section-image-text .section-copy {
    grid-column: 2;
}

.list-section-text-image .section-image {
    grid-column: 2;
    grid-row: 1;
}

.list-section-text-image .section-copy {
    grid-column: 1;
    grid-row: 1;
}

@media (max-width: 768px) {
    .section-content {
        gap: 2rem;
        grid-template-columns: 1fr;
    }

    .section-content > .section-image {
        grid-column: auto;
        grid-row: auto;
        width: 100%;
    }

    .list-section-text-image .section-content .section-copy {
        grid-column: auto;
        grid-row: auto;
        order: -1;
    }

    .wedding-section p {
        line-height: 1.3;
    }
}
</style>
