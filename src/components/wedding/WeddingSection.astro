---
const { section } = Astro.props;
const image = section?.imageUrl || section?.imageData || section?.image || null;
const text = section?.text || "";
const title = section?.title || "";
---

<section
    class:list-section-image-text={section.type === "image-text"}
    class:list-section-text-image={section.type === "text-image"}
    class="wedding-section"
>
    {section.type === "text" && title && <h2>{title}</h2>}
    {section.type === "image" && image && (
        <img src={image} alt={title} loading="lazy" />
    )}
    {section.type === "text" && text && <p>{text}</p>}
    {(section.type === "image-text" || section.type === "text-image") && (
        <div class="section-content">
            {image && <img src={image} alt={title} loading="lazy" />}
            <div class="section-copy">
                {title && <h2>{title}</h2>}
                {text && <p>{text}</p>}
            </div>
        </div>
    )}
</section>

<style>
.wedding-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem 0;
}

.wedding-section h2,
.wedding-section p {
    margin: 0;
    white-space: pre-wrap;
}

.wedding-section img {
    border-radius: 1rem;
    max-height: 32rem;
    max-width: 100%;
    object-fit: cover;
}

.section-content {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr 1fr;
}

.list-section-text-image .section-content .section-copy {
    grid-column: 1;
    grid-row: 1;
}

.list-section-text-image .section-content img {
    grid-column: 2;
    grid-row: 1;
}

.list-section-image-text .section-content img {
    grid-column: 1;
    grid-row: 1;
}

.list-section-image-text .section-content .section-copy {
    grid-column: 2;
    grid-row: 1;
}

@media (max-width: 768px) {
    .section-content {
        display: flex;
        flex-direction: column;
    }

    .list-section-text-image .section-content .section-copy {
        order: -1;
    }
}
</style>
