---
import { Image } from "astro:assets";

import WeddingItemActions from "@/components/wedding/WeddingItemActions.vue";
import {
    getItemImageUrl,
    getWebsiteHostname,
    getWebsiteUrl,
} from "@/utils/listItems";

const { item, list, wishlistOwner } = Astro.props;
const showFulfillment = !wishlistOwner || list.spoilSurprises;
const websiteUrl = getWebsiteUrl(item.url);
const imageUrl = getItemImageUrl(item);
const imageSource = imageUrl?.startsWith("/")
    ? new URL(imageUrl, Astro.url).toString()
    : imageUrl;
const merchant = getWebsiteHostname(item.url) || null;
const priceHasDecimals = Number(item.price) % 1 !== 0;
const formattedPrice =
    item.price != null && item.displayPrice
        ? new Intl.NumberFormat("en-GB", {
              currency: list.currency || "GBP",
              maximumFractionDigits: priceHasDecimals ? 2 : 0,
              minimumFractionDigits: priceHasDecimals ? 2 : 0,
              style: "currency",
          }).format(item.price)
        : null;
const itemForClient = {
    description: item.description,
    displayPrice: item.displayPrice,
    fulfillment: item.fulfillment,
    id: item.id,
    image: item.image,
    imageID: item.imageID,
    price: item.price,
    priority: item.priority,
    title: item.title,
    url: item.url,
};
const listForClient = {
    currency: list.currency,
    id: list.id,
    private: list.private,
    spoilSurprises: list.spoilSurprises,
    type: list.type,
};
---

<article
    class:list-item-fulfilled={showFulfillment && Boolean(item.fulfillment)}
    class:list-item-no-image={!imageUrl}
    class="wedding-item-card"
    data-item-id={item.id}
>
    {imageUrl && (
        <div class="item-image">
            <Image
                src={imageSource}
                alt={item.title}
                width="500"
                height="500"
            />
        </div>
    )}
    <div class="item-details">
        <div class="item-copy">
            {merchant && <p class="item-merchant">{merchant}</p>}
            <h3>{item.title}</h3>
            {item.description && (
                <p class="item-description">{item.description}</p>
            )}
        </div>
        <div class="item-bottom">
            <div class="item-meta">
                {formattedPrice && (
                    <span class="item-price">{formattedPrice}</span>
                )}
                {showFulfillment && item.fulfillment?.name && (
                    <span class="item-status">
                        Fulfilled by {item.fulfillment.name}
                    </span>
                )}
                {item.priority && item.priority !== "none" && (
                    <span class="item-status">{item.priority}</span>
                )}
            </div>
            <WeddingItemActions
                client:only="vue"
                currency={list.currency || "USD"}
                item={itemForClient}
                list={listForClient}
                showFulfillment={showFulfillment}
                wishlistOwner={wishlistOwner}
            />
        </div>
    </div>
</article>

<style>
.wedding-item-card {
    display: grid;
    grid-template-columns: minmax(13rem, 16.5rem) minmax(0, 1fr);
    min-height: 17rem;
    overflow: hidden;
}

.wedding-item-card.list-item-fulfilled {
    filter: saturate(0.45);
}

.wedding-item-card.list-item-no-image {
    grid-template-columns: 1fr;
}

.item-image {
    background: #f2f2f0;
    min-height: 17rem;
}

.item-image img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
}

.item-details {
    background: var(--wedding-card, var(--wedding-surface));
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: space-between;
    padding: clamp(1.25rem, 2.3vw, 2rem);
}

.item-copy h3 {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0.65rem 0 0;
    overflow-wrap: anywhere;
}

.item-merchant,
.item-description {
    margin: 0;
    white-space: pre-wrap;
}

.item-merchant {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
}

.item-description {
    margin-top: 1rem;
}

.item-bottom {
    align-items: flex-end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
}

.item-meta {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.item-price {
    font-family: "Segoe Print", "Bradley Hand", "Apple Chancery", cursive;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1;
}

.item-status {
    color: rgb(25 28 32 / 0.7);
    font-size: 0.875rem;
    text-transform: capitalize;
}

:global(.wedding-items[data-view="grid"]) .wedding-item-card {
    grid-template-columns: 1fr;
}

:global(.wedding-items[data-view="grid"]) .item-image {
    height: 16rem;
    min-height: 0;
}

:global(.wedding-items[data-view="grid"]) .item-bottom {
    align-items: stretch;
    flex-direction: column;
}

@media screen and (max-width: 768px) {
    .wedding-item-card {
        grid-template-columns: 1fr;
    }

    .item-image {
        height: 15rem;
        min-height: 0;
    }

    .item-bottom {
        align-items: stretch;
        flex-direction: column;
    }
}
</style>
