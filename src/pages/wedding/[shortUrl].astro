---
import { and, eq, inArray, isNull } from "drizzle-orm";
import "@/assets/wedding.scss";
import { requireAuth } from "@/auth";
import ItemCard from "@/components/wedding/ItemCard.astro";
import WeddingCreateItem from "@/components/wedding/WeddingCreateItem.vue";
import WeddingHeaderActions from "@/components/wedding/WeddingHeaderActions.vue";
import WeddingSection from "@/components/wedding/WeddingSection.astro";
import WeddingSectionsManager from "@/components/wedding/WeddingSectionsManager.vue";
import { db } from "@/db";
import AstroLayout from "@/layouts/AstroLayout.astro";
import { fulfillments, items, lists as listsTable } from "@/schema";
import {
    normalizeWeddingAccent,
    weddingAccentTheme,
} from "@/utils/weddingTheme";

const shortUrl = Astro.params.shortUrl;
const [list] = await db
    .select()
    .from(listsTable)
    .where(
        and(eq(listsTable.shortUrl, shortUrl), eq(listsTable.type, "wedding")),
    );

if (!list) {
    return Astro.rewrite("/404");
}

const { user } = await requireAuth(Astro);

// TODO: Re-enable private list check
// if (list.private && user?.id !== list.author) {
//     return Astro.rewrite("/404");
// }

const weddingSections = list.weddingSections ?? [];
const weddingItems = await db
    .select()
    .from(items)
    .where(and(eq(items.list, list.id), isNull(items.communityList)));
const weddingItemIDs = weddingItems.map((item) => item.id);
const itemFulfillments = weddingItemIDs.length
    ? await db
          .select()
          .from(fulfillments)
          .where(inArray(fulfillments.item, weddingItemIDs))
    : [];
const itemsWithFulfillments = weddingItems
    .sort((a, b) => (a.price ?? 0) - (b.price ?? 0))
    .map((item) => ({
        ...item,
        fulfillment:
            itemFulfillments.find(
                (fulfillment) => fulfillment.item === item.id,
            ) ?? null,
    }));
const canManage = user?.id === list.author;
const accentColor = normalizeWeddingAccent(list.accentColor);
const accentTheme = weddingAccentTheme(accentColor);
const editableList = {
    currency: list.currency,
    accentColor,
    description: list.description,
    id: list.id,
    private: list.private,
    registryTitle: list.registryTitle,
    shortUrl: list.shortUrl,
    spoilSurprises: list.spoilSurprises,
    title: list.title,
    type: list.type,
    weddingDate: list.weddingDate,
    weddingSections: list.weddingSections ?? [],
};
---

<AstroLayout title={list.title} accentColor={accentColor}>
    <div
        class={`wedding-theme wedding-theme--${accentTheme}`}
        style={`--wedding-accent: ${accentColor};`}
    >
        <div class="header">
            <h1>{list.title}</h1>
            <div class="subheader">
                {list.weddingDate && (
                    <span class="weddingDate">{list.weddingDate}</span>
                )}
                {list.weddingDate && list.registryTitle && (
                    <span> &bull; </span>
                )}
                {list.registryTitle && (
                    <span class="registryTitle">{list.registryTitle}</span>
                )}
            </div>
        </div>
        <div class="wedding-content">
            {canManage && (
                <WeddingSectionsManager list={editableList} client:only="vue" />
            )}
            <div class="sections" data-wedding-sections>
                {weddingSections.map((section) => (
                    <WeddingSection section={section} />
                ))}
            </div>
            {itemsWithFulfillments.length > 0 ? (
                    <div class="wedding-items-header">
                        <h2>The registry</h2>
                        <div class="items-controls"></div>
                    </div>
                    <div class="wedding-items">
                        {itemsWithFulfillments.map((item) => (
                            <ItemCard
                                item={item}
                                list={list}
                                wishlistOwner={canManage}
                            />
                        ))}
                    </div>
            ) : (
                <p>No items yet</p>
            )}
        </div>
    </div>
    {canManage && (
        <div slot="pageActions">
            <WeddingHeaderActions list={editableList} client:only="vue" />
        </div>
    )}
    {canManage && <WeddingCreateItem list={editableList} client:only="vue" />}
</AstroLayout>

<style>
:global(html),
:global(body) {
    background: #f8f7f0;
    color: #191c20;
    color-scheme: light;
}

.header {
    text-align: center;
    h1 {
        color: var(--wedding-accent);
        font-size: 3rem;
    }
    .subheader {
        font-size: 1.5rem;
    }
}

.wedding-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem auto;
    width: 100%;
}

.wedding-content {
    display: flex;
    flex-direction: column;
    width: 100%;
}
</style>
