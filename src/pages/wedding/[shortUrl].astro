---
import { and, eq, inArray, isNull } from "drizzle-orm";
import "@/assets/wedding.scss";
import { requireAuth } from "@/auth";
import ItemCard from "@/components/wedding/ItemCard.astro";
import WeddingCreateItem from "@/components/wedding/WeddingCreateItem.vue";
import WeddingHeaderActions from "@/components/wedding/WeddingHeaderActions.vue";
import WeddingItemsViewToggle from "@/components/wedding/WeddingItemsViewToggle.vue";
import WeddingSection from "@/components/wedding/WeddingSection.astro";
import WeddingSectionsManager from "@/components/wedding/WeddingSectionsManager.vue";
import { db } from "@/db";
import AstroLayout from "@/layouts/AstroLayout.astro";
import { fulfillments, items, lists as listsTable } from "@/schema";
import { groupListItems, WEDDING_PRICE_GROUPS } from "@/utils/listItems";
import { focusPosition } from "@/utils/weddingFocus";
import {
    normalizeWeddingAccent,
    weddingAccentTheme,
} from "@/utils/weddingTheme";

const shortUrl = Astro.params.shortUrl;
const [list] = await db
    .select()
    .from(listsTable)
    .where(
        and(eq(listsTable.shortUrl, shortUrl), eq(listsTable.type, "wedding")),
    );

if (!list) {
    return Astro.rewrite("/404");
}

const { user } = await requireAuth(Astro);
const canManage = user?.id === list.author;

// TODO: Re-enable private list check
// if (list.private && user?.id !== list.author) {
//     return Astro.rewrite("/404");
// }

const weddingSections = list.weddingSections ?? [];
const weddingDate = /^\d{4}-\d{2}-\d{2}$/.test(list.weddingDate ?? "")
    ? `${list.weddingDate.slice(8, 10)}.${list.weddingDate.slice(5, 7)}.${list.weddingDate.slice(0, 4)}`
    : list.weddingDate;
const heroSections = [];
for (const section of weddingSections) {
    if (
        heroSections.length === 3 ||
        section.type !== "image" ||
        !(section.imageUrl || section.imageData || section.image)
    ) {
        break;
    }
    heroSections.push(section);
}
if (heroSections.length !== 3) heroSections.length = 0;
const storySections = weddingSections.slice(heroSections.length);
const weddingItems = await db
    .select()
    .from(items)
    .where(and(eq(items.list, list.id), isNull(items.communityList)));
const weddingItemIDs = weddingItems.map((item) => item.id);
const itemFulfillments = weddingItemIDs.length
    ? await db
          .select()
          .from(fulfillments)
          .where(inArray(fulfillments.item, weddingItemIDs))
    : [];
const itemsWithFulfillments = weddingItems
    .sort((a, b) => (a.price ?? 0) - (b.price ?? 0))
    .map((item) => ({
        ...item,
        fulfillment:
            itemFulfillments.find(
                (fulfillment) => fulfillment.item === item.id,
            ) ?? null,
    }));
const itemGroups = groupListItems({
    currency: list.currency,
    flexibleTitle: "Other gifts",
    includeCommunityItems: false,
    items: itemsWithFulfillments,
    priceGroups: WEDDING_PRICE_GROUPS,
    rangeSeparator: "–",
    wishlistOwner: canManage,
});
const accentColor = normalizeWeddingAccent(list.accentColor);
const accentTheme = weddingAccentTheme(accentColor);
const editableList = {
    currency: list.currency,
    accentColor,
    description: list.description,
    id: list.id,
    private: list.private,
    registryTitle: list.registryTitle,
    shortUrl: list.shortUrl,
    spoilSurprises: list.spoilSurprises,
    title: list.title,
    type: list.type,
    weddingDate: list.weddingDate,
    weddingSections: list.weddingSections ?? [],
};
---

<AstroLayout
    title={list.title}
    accentColor={accentColor}
    pageClass="wedding-page"
>
    <script is:inline>
    try {
        if (localStorage.getItem("wedding-items-view") === "grid") {
            document.documentElement.dataset.weddingItemsView = "grid";
        }
    } catch {}
    </script>
    <div
        class={`wedding-theme wedding-theme--${accentTheme}`}
        style={`--wedding-accent: ${accentColor};`}
    >
        <div class="wedding-heading">
            <h1>{list.title}</h1>
            <div class="subheader">
                {weddingDate && <span class="weddingDate">{weddingDate}</span>}
                {weddingDate && list.registryTitle && <span> &bull; </span>}
                {list.registryTitle && (
                    <span class="registryTitle">{list.registryTitle}</span>
                )}
            </div>
        </div>
        {canManage && (
            <div class="wedding-editor">
                <WeddingSectionsManager list={editableList} client:only="vue" />
            </div>
        )}
        {heroSections.length > 0 && (
            <div class="wedding-gallery" data-wedding-section>
                {heroSections.map((section, index) => (
                    <img
                        src={
                            section.imageUrl ||
                            section.imageData ||
                            section.image
                        }
                        alt={section.title || ""}
                        style={`object-position: ${focusPosition(section)}; aspect-ratio: ${[1450, 667, 1300][index]} / 1000;`}
                        width={[1450, 667, 1300][index]}
                        height="1000"
                    />
                ))}
            </div>
        )}
        {storySections.map((section) => <WeddingSection section={section} />)}
        <div class="wedding-registry" id="registry">
            <div class="wedding-items-header">
                <h2>The registry</h2>
                <div class="items-controls">
                    {canManage && (
                        <div class="create-item-slot">
                            <WeddingCreateItem
                                inline
                                list={editableList}
                                client:only="vue"
                            />
                        </div>
                    )}
                    {itemsWithFulfillments.length > 0 && (
                        <div class="view-toggle-slot">
                            <WeddingItemsViewToggle client:load />
                        </div>
                    )}
                </div>
            </div>
            {itemGroups.length > 0 ? (
                <div class="registry-groups">
                    {itemGroups.map((group) => (
                        <section class="registry-group">
                            <h3 class="registry-group-title">{group.title}</h3>
                            <div
                                class="wedding-items"
                                data-wedding-items
                                data-view="line"
                            >
                                {group.items.map((item) => (
                                    <ItemCard
                                        item={item}
                                        list={list}
                                        wishlistOwner={canManage}
                                    />
                                ))}
                            </div>
                        </section>
                    ))}
                </div>
            ) : (
                <p class="empty-registry">No items yet</p>
            )}
        </div>
        <p class="wedding-thanks">Thank you</p>
        <footer class="wedding-footer">
            <div class="wedding-footer-inner">
                <a href="/">Readyto.gift</a>
                <nav aria-label="Legal">
                    <a href="/legal/privacy">Privacy</a>
                    <a href="/legal/terms">Terms</a>
                </nav>
            </div>
        </footer>
    </div>
    {canManage && (
        <div slot="pageActions">
            <WeddingHeaderActions list={editableList} client:only="vue" />
        </div>
    )}
</AstroLayout>
