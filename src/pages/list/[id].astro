---
import { createAdminClient } from "@/server/appwrite";

import { Query } from "node-appwrite";
import { APPWRITE_DB, APPWRITE_LIST_COLLECTION } from "astro:env/client";

import NewLayout from "@/layouts/NewLayout.astro";

import ListHeader from "@/components/new/list/Header.astro";
import ItemCard from "@/components/new/list/Item.astro";

import { Icon } from "astro-icon/components";

import { formatter as currencyFormatter } from "@/stores/currency";
import { undefined } from "astro:schema";

const { id } = Astro.params;
export const prerender = false;

let user;
let list;

let sessionClient;
let adminClient;

if (Astro.locals.session) {
    user = Astro.locals.session.account;

    sessionClient = Astro.locals.session.sessionClient;

    list = await sessionClient.tablesDB.getRow({
        databaseId: APPWRITE_DB,
        tableId: APPWRITE_LIST_COLLECTION,
        rowId: id,
        queries: [Query.select(["*", "items.*"])]
    });
} else {
    adminClient = createAdminClient();
    list = await adminClient.tablesDB.getRow({
        databaseId: APPWRITE_DB,
        tableId: APPWRITE_LIST_COLLECTION,
        rowId: id,
        queries: [Query.select(["*", "items.*"])]
    });

    if (list.private) {
        list = null;
    }
}

if (!list) {
    return new Response("Not Found", { status: 404 });
}

const priceGroups = [0, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000, Infinity];

const itemsByPriceGroups = priceGroups
    .map((price, index) => {
        const lowerBound = index === 0 ? 0 : priceGroups[index - 1];
        const upperBound = price;
        const title =
            price === 0
                ? "Flexible Gifts"
                : currencyFormatter(list.currency).format(lowerBound).split(".")[0] +
                  " - " +
                  currencyFormatter(list.currency).format(upperBound).split(".")[0];

        const groupItems = list.items
            .filter((item) => {
                const itemPrice = typeof item.price === "number" ? item.price : 0;
                if (upperBound === 0) {
                    return itemPrice === 0;
                }
                if (upperBound === Infinity) {
                    return itemPrice > priceGroups[priceGroups.length - 2];
                }
                return itemPrice > lowerBound && itemPrice <= upperBound;
            })
            .sort((a, b) => a.title?.localeCompare(b.title || "") || 0);

        return {
            title,
            price: upperBound,
            items: groupItems
        };
    })
    .filter((group) => group.items.length > 0);

if (user) {
    let history = [];
    // check all lists are accessible
    if (user?.prefs?.history && user.prefs.history.length) {
        const historyIDs = user.prefs.history
            .map((i) => i.id)
            .filter((id) => typeof id === "string");

        const historyItems = await sessionClient.tablesDB.listRows({
            databaseId: APPWRITE_DB,
            tableId: APPWRITE_LIST_COLLECTION,
            queries: [Query.equal("$id", historyIDs)]
        });

        history = historyItems.rows.map((row) => ({
            id: row.$id,
            avatar: sessionClient?.avatars.getInitials({
                name: row.authorName
            }),
            title: row.title,
            subtitle: `By ${row.authorName}`
        }));
    }

    history.unshift({
        id: id,
        avatar: sessionClient.avatars.getInitials({
            name: list.authorName
        }),
        title: list.title,
        subtitle: `By ${list.authorName}`
    });

    history = history
        .filter((v, i, a) => a.findIndex((t) => t.id === v.id) === i) // remove duplicates
        .slice(0, 10);

    user.prefs.history = history;
    await sessionClient.account.updatePrefs(user.prefs);
}
---

<NewLayout title={list.title} user={user}>
    <ListHeader list={list} user={user} />
    <section class="mt-8">
        {
            itemsByPriceGroups.length ? (
                itemsByPriceGroups.map((group) => (
                    <section key={group.title} class="mb-10">
                        <div class="mb-4 flex flex-col sm:flex-row items-start sm:items-center sm:justify-between gap-3 rounded-3xl bg-base-200 p-3 sm:p-4">
                            <div>
                                <h3 class="text-base sm:text-lg font-semibold">{group.title}</h3>
                                <p class="text-sm text-base-content/70">
                                    {group.items.length} item{group.items.length === 1 ? "" : "s"}
                                </p>
                            </div>
                        </div>
                        <div class="items flex flex-col gap-4 sm:gap-6">
                            {group.items.map((item) => (
                                <ItemCard item={item} list={list} key={item.$id} />
                            ))}
                        </div>
                    </section>
                ))
            ) : (
                <div class="rounded-2xl border border-base-300 bg-base-100 p-8 text-center shadow-sm">
                    <h2 class="text-xl font-semibold">No items yet</h2>
                    <p class="mt-3 text-base-content/70">This list doesn't have any items yet.</p>
                </div>
            )
        }
    </section>
</NewLayout>
