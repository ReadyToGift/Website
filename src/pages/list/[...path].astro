---
import App from "@/layouts/App.vue";
import Layout from "@/layouts/Layout.astro";
import { GET as getList } from "@/pages/api/content/list/index.js";

export const prerender = false;

const listId = Astro.params.path;
if (!listId) {
    return new Response("Not Found", { status: 404 });
}

// Call on behalf of user
const response = await getList({
    url: new URL(
        `/api/content/list?listId=${encodeURIComponent(listId)}`,
        Astro.url,
    ),
    locals: Astro.locals,
});
if (!response.ok) {
    return new Response("Not Found", { status: 404 });
}

const listData = await response.json();
const title = `${listData.list.title} - Readyto.gift`;
const description =
    listData.list.description?.trim() ||
    `View ${listData.list.title} by ${listData.list.authorName} on Readyto.gift.`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
console.log({ listData });
const image = listData.list.author
    ? new URL(`/api/avatar/${listData.list.author}`, Astro.url.origin).href
    : null;
---

<Layout
    title={title}
    description={description}
    image={image}
    url={canonicalUrl}
>
    <App client:only="vue" />
</Layout>
