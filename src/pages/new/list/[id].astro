---
import { createAdminClient } from "@/server/appwrite";
import { Query } from "node-appwrite";
import { APPWRITE_DB, APPWRITE_LIST_COLLECTION } from "astro:env/client";

import NewLayout from "@/layouts/NewLayout.astro";

import ListHeader from "@/components/list/Header.astro";
import ItemCard from "@/components/list/Item.astro";

import { formatter as currencyFormatter } from "@/stores/currency";

const { id } = Astro.params;
export const prerender = false;

const client = createAdminClient();
const list = await client.tablesDB.getRow({
    databaseId: APPWRITE_DB,
    tableId: APPWRITE_LIST_COLLECTION,
    rowId: id,
    queries: [Query.select(["*", "items.*"])]
});

if (list.total === 0) {
    return new Response("Not Found", { status: 404 });
}

const items = list.items || [];

const priceGroups = [0, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000, Infinity];

const itemsByPriceGroups = priceGroups
    .map((price, index) => {
        const lowerBound = index === 0 ? 0 : priceGroups[index - 1];
        const upperBound = price;
        const title =
            price === 0
                ? "Flexible Gifts"
                : currencyFormatter(list.currency).format(lowerBound).split(".")[0] +
                  " - " +
                  currencyFormatter(list.currency).format(upperBound).split(".")[0];

        const groupItems = items
            .filter((item) => {
                const itemPrice = typeof item.price === "number" ? item.price : 0;
                if (upperBound === 0) {
                    return itemPrice === 0;
                }
                if (upperBound === Infinity) {
                    return itemPrice > priceGroups[priceGroups.length - 2];
                }
                return itemPrice > lowerBound && itemPrice <= upperBound;
            })
            .sort((a, b) => a.title?.localeCompare(b.title || "") || 0);

        return {
            title,
            price: upperBound,
            items: groupItems
        };
    })
    .filter((group) => group.items.length > 0);
---

<NewLayout>
    <ListHeader list={list} />
    {
        itemsByPriceGroups.map((group) => (
            <div key={group.title} className="my-6">
                <h2 className="text-xl font-semibold mb-2">{group.title}</h2>
                <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-4">
                    {group.items.map((item) => (
                        <ItemCard key={item.$id} item={item} list={list} />
                    ))}
                </div>
            </div>
        ))
    }
</NewLayout>
